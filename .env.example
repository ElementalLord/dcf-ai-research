# Copy to .env.local for local development. In production, enter the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Only NEXT_PUBLIC_SUPABASE_URL may use the NEXT_PUBLIC_ prefix; everything else is server-only.

# --- Required ---------------------------------------------------------------
# Supabase → Project Settings → API (or Data API): Project URL and the service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Resources/admin access. Generate both with `npm run admin:setup` (writes them to .env.local
# and prints the admin key once). ADMIN_SESSION_SECRET also keys the rate-limit client hashes.
CORPUS_ADMIN_TOKEN_HASH=sha256-hex-of-admin-access-key
ADMIN_SESSION_SECRET=long-random-hex-string

# --- AI and search providers (the site still works without them, extractive answers only) ---
# Google AI Studio → Get API key (the key's Google Cloud project carries the billing).
GEMINI_API_KEY=your-gemini-api-key
# Brave Search API dashboard → API keys.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# Set true only if the Brave plan grants storage rights; otherwise results are never cached.
# BRAVE_SEARCH_STORAGE_RIGHTS=false

# --- Models -----------------------------------------------------------------
GEMINI_GENERATION_MODEL=gemini-3.7-flash
GEMINI_GROUNDING_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional provider-neutral settings. Existing AI_SYNTHESIS_MODE remains compatible.
# SYNTHESIS_PROVIDER=gemini
# SYNTHESIS_MODEL=gemini-3.7-flash
# One alternate attempt for a transient primary failure (503/network/timeout only).
SYNTHESIS_ALTERNATE_MODEL=gemini-3.5-flash-lite
# SYNTHESIS_ALTERNATE_DISABLED=false
SYNTHESIS_TIMEOUT_MS=40000

# --- Behaviour switches -----------------------------------------------------
# When a Gemini key is configured, Ask uses Gemini by default. Set to local for an extractive-only mode.
# AI_SYNTHESIS_MODE=local
# Optional. Deterministic local reranking is the default to preserve generation quota.
ENABLE_MODEL_RERANK=false
# Strict permits reviewed human, mentor, automated-evidence, or corpus-evidence claims with approved passage evidence.
EVIDENCE_POLICY_MODE=strict
DEMAND_RESEARCH_ENABLED=false
DEMAND_VERIFICATION_SHADOW_ENABLED=false
DEMAND_AUTO_ADMISSION_ENABLED=false
DEMAND_TELEMETRY_ENABLED=false
# Record what live search reads and reuse it before paying for another search (on by default).
# KNOWLEDGE_HARVEST_ENABLED=true
# After an answer, also index other passages about the person on the pages it read (on by default).
# KNOWLEDGE_DEEP_HARVEST_ENABLED=true
# Publish facts that pass every verification gate as approved claims, with no reviewer (on by default).
# KNOWLEDGE_AUTO_ADMISSION_ENABLED=true
# Admin corpus expansion auto-admits strong candidates unless set to false.
# ADAPTIVE_AUTO_ADMIT=true
# Development audit only: bypass answer-cache reads and writes to measure fresh generation.
# ANSWER_CACHE_DISABLED=false
# Set true to test core retrieval/extractive answers without deleting credentials.
SYNTHESIS_DISABLED=false
EMBEDDINGS_DISABLED=false
# Local admin document cache (defaults to ./.corpus-cache/documents).
# CORPUS_DOCUMENT_CACHE_DIR=
