      "locator": "son Dorabji",
      "text_sha256": "f6402a92d82526efcb2270867f6609e23ea5a85b27c4e272de0799089c3787be",
      "excerpt_preview": "His son Dorabji and later associates carried the hydroelectric project to completion.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "396ed6cd-50b0-4fc8-881f-1e9a5c2370a1",
      "locator": "preliminary work rather than a completed plant",
      "text_sha256": "c6262b30c604ffb4ec16db5b249d2032c94b41753b26d7527dd8a7455315b9e6",
      "excerpt_preview": "At his death in 1904, preliminary work rather than a completed plant existed.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "7b55cff4-e9ae-4f99-bf3b-a02c3b23f1cd",
      "locator": "opposed an exclusive electricity monopoly",
      "text_sha256": "196bb7d5d647acd6e09d5870632e29f7f595a3829bcdd4530920b469daecc5d7",
      "excerpt_preview": "He sought government support and opposed an exclusive electricity monopoly.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "8e3c29f9-9249-49bc-a762-de3ac6e9a229",
      "locator": "as early as 1875",
      "text_sha256": "39c3a45664d434ddb05393e36d35ed1f2fbc2f34fe69f26b53f07a2551eda235",
      "excerpt_preview": "amsetji Tata contemplated hydraulic energy development as early as 1875.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "e50bb515-1559-4b0f-86aa-36cbdafecda9",
      "locator": "Western Ghats",
      "text_sha256": "65bd6ae6e02a0ea0094b679ce2faccc60dfe4faf3148b850e972daa3b2db34a2",
      "excerpt_preview": "His scheme proposed using water from the Western Ghats to generate electricity for Bombay and nearby mills.",
      "excerpt_truncated": false,
      "screen_only": true
    }
