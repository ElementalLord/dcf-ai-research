    {
      "chunk_id": "1c0cf98b-5dcb-455a-b7e0-31b9633b428d",
      "locator": "bringing cultures together",
      "text_sha256": "e060f8ee8b7ff56f5d9519fc81efdc5ff498cc3ffad75ec67da738bda6b913ee",
      "excerpt_preview": "Its purpose included bringing cultures together for study and creation.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "5c46b186-dde5-4220-832a-72a982188934",
      "locator": "opened the Brahmacharyasrama school",
      "text_sha256": "ca9204351690ddb8dd1199eeb761cbb00cb0dad531d9ba7b728f24caba7f4878",
      "excerpt_preview": "Rabindranath Tagore formally opened the Brahmacharyasrama school there on 22 December 1901 with five students.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "63d8c18b-433d-4416-89f6-462015733f69",
      "locator": "founded Visva-Bharati in 1921",
      "text_sha256": "e91255dc1a8e069fcd65ea47f7b4ffd0f9e35f21f9b44594a13caa8b2ce42666",
      "excerpt_preview": "Tagore developed an unconventional university around the school and founded Visva-Bharati in 1921.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "677f4103-e053-41fe-9989-639dc5be5474",
      "locator": "classes met in the open air",
      "text_sha256": "ed5b29ba9efcb912ba82bd807402510b8cb5833378ac9d6fe7f7b49c8171aa0c",
      "excerpt_preview": "The school consciously departed from colonial classroom conventions: classes met in the open air, simplicity mattered, and music, painting and drama belonged within education.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "86e2a8c0-7372-4c76-90d5-daf5d5002296",
      "locator": "central university and institution of national importance in 1951",
      "text_sha256": "8fdd704faba189d6b3e87fd0deab026bc1b579560aed16734d0f438777a638ac",
      "excerpt_preview": "Parliament made Visva-Bharati a central university and institution of national importance in 1951.",
      "excerpt_truncated": false,
      "screen_only": true
    }
  ],
