  "passages": [
    {
      "chunk_id": "268fb79f-4295-4915-8959-47fd01ea4605",
      "locator": "born on 3 March 1839",
      "text_sha256": "41119b0c12cdf7435cb8306d1cb56e74f3b065f57d13f48ae987dc2f964cce60",
      "excerpt_preview": "amsetji Nusserwanji Tata was born on 3 March 1839 in Navsari, Gujarat.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "61d3d138-45fd-4289-8e5a-3bde7ecbae04",
      "locator": "donated over 370 acres",
      "text_sha256": "b10ba72f78b7ca8055f42ad1e05195fd62fdce637ff8f6f74b008e39d5102f07",
      "excerpt_preview": "The Mysore Durbar donated over 370 acres in Bengaluru.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "8410decc-5f43-4b0a-9de6-c38f12369271",
      "locator": "died in 1904 before the Institute",
      "text_sha256": "59901e62a183cfd0b56b715faccdc612a176d1eccb59e691a419a38efc227e83",
      "excerpt_preview": "Tata died in 1904 before the Institute came into existence.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "841496df-8dbb-428b-a2ee-b4e9b8997eb2",
      "locator": "university of science in 1896",
      "text_sha256": "e6d9d26d914bc85e34827f89a0d685ee4246de54118c244a7b3c90f16c66d7c0",
      "excerpt_preview": "Tata conceived a university of science in 1896 that would work for the benefit of India, and in 1898 created an endowment for establishing such an institution.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "8f2dd2af-3595-4fa8-8f88-25f9a405f25f",
      "locator": "first students began study in 1911",
      "text_sha256": "ca872eb74518abb7c5fd70c1eadaa24abc1c62dad395130d05f415351c3c6d76",
      "excerpt_preview": "The first students began study in 1911 in General and Applied Chemistry and Electrical Technology.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "c64bbbd4-81c9-427f-b653-8aa561685d86",
      "locator": "joint efforts of Tata, the Government of India and the Maharaja of Mysore",
      "text_sha256": "dae67ea2c90babb4a3010a48d4dea89cea01d1cc6c036b4a9f0e73ace6282714",
      "excerpt_preview": "IISc was founded in 1909 through joint efforts of Tata, the Government of India and the Maharaja of Mysore.",
      "excerpt_truncated": false,
      "screen_only": true
    },
    {
      "chunk_id": "e457a518-1760-4c6b-ad41-4eb32396324f",
      "locator": "Burjorji Padshah",
      "text_sha256": "179fafe18f4645974d7c4e364b21f17797240e2a716d60d4e255f3987fa66fc6",
      "excerpt_preview": "He set up a provisional committee under educationist Burjorji Padshah to prepare a blueprint.",
      "excerpt_truncated": false,
      "screen_only": true
    }
  ],
